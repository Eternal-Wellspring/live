{
  "redirects": [
    {
      "source": "/:site((?!bible|scriptures|sky-images|api|images|sites|topics)[^/.]+)",
      "destination": "/:site/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/bible", "destination": "/api/bible" },
    { "source": "/scriptures", "destination": "/api/scriptures" },
    { "source": "/sky-images", "destination": "/images/sky/list.json" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sons.eternalwellspring.com" }],
      "destination": "/sites/sons-of-god-arise/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sons.eternalwellspring.com" }],
      "destination": "/sites/sons-of-god-arise/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "soga.eternalwellspring.com" }],
      "destination": "/sites/sons-of-god-arise/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "soga.eternalwellspring.com" }],
      "destination": "/sites/sons-of-god-arise/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sonsofgodarise.eternalwellspring.com" }],
      "destination": "/sites/sons-of-god-arise/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sonsofgodarise.eternalwellspring.com" }],
      "destination": "/sites/sons-of-god-arise/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "sons-of-god-arise.eternalwellspring.com" }],
      "destination": "/sites/sons-of-god-arise/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sons-of-god-arise.eternalwellspring.com" }],
      "destination": "/sites/sons-of-god-arise/:path*"
    },
    { "source": "/topics", "destination": "/index.html" },
    { "source": "/topics/", "destination": "/index.html" },
    { "source": "/soga", "destination": "/sites/sons-of-god-arise/" },
    { "source": "/soga/", "destination": "/sites/sons-of-god-arise/index.html" },
    { "source": "/soga/:path*", "destination": "/sites/sons-of-god-arise/:path*" },
    { "source": "/sonsofgodarise", "destination": "/sites/sons-of-god-arise/" },
    { "source": "/sonsofgodarise/", "destination": "/sites/sons-of-god-arise/index.html" },
    { "source": "/sonsofgodarise/:path*", "destination": "/sites/sons-of-god-arise/:path*" },
    {
      "source": "/:site((?!bible|scriptures|sky-images|api|images|sites|topics)[^/.]+)/",
      "destination": "/sites/:site/index.html"
    },
    {
      "source": "/:site((?!bible|scriptures|sky-images|api|images|sites|topics)[^/.]+)/:path*",
      "destination": "/sites/:site/:path*"
    }
  ],
  "functions": {
    "api/scriptures.js": {
      "includeFiles": "scriptures.json"
    }
  }
}
