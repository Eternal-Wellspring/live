{
  "redirects": [
    {
      "source": "/sites/sons-of-god-arise/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "sons-of-god-arise.eternalwellspring.com"
        }
      ],
      "destination": "/sites/sons-of-god-arise/:path*"
    }
  ]
}